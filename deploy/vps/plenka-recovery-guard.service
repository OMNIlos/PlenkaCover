[Unit]
Description=PlenkaCover recovery guard
Requires=docker.service
After=docker.service network-online.target
ConditionFileIsExecutable=/opt/plenka/current/backend/scripts/vps/recovery-guard.sh

[Service]
Type=oneshot
Environment=PLENKA_ENV_FILE=/opt/plenka/shared/pilot.env
ExecStart=/opt/plenka/current/backend/scripts/vps/recovery-guard.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run
