(plenka_frontend_routes) {
	route {
		handle /api/* {
			reverse_proxy api:3000
		}

		@sourceMaps path *.map
		handle @sourceMaps {
			respond 404
		}

		handle /assets/* {
			root * /srv
			try_files {path} =404
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		handle {
			root * /srv
			try_files {path} /index.html
			header Cache-Control "no-cache, no-store, must-revalidate"
			file_server
		}
	}
}
