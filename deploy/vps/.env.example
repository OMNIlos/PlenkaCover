# Documentation template only. validate-env.sh intentionally rejects every replace-me value.
COMPOSE_PROJECT_NAME=plenka-pilot
PLENKA_API_IMAGE=plenka-api:replace-me-git-sha
PLENKA_MIGRATION_IMAGE=plenka-migration:replace-me-git-sha
PLENKA_WEB_IMAGE=plenka-web:replace-me-git-sha

PUBLIC_HOST=replace-me.example.com
PUBLIC_ORIGIN=https://replace-me.example.com
ACME_EMAIL=replace-me@example.com

POSTGRES_ADMIN_USER=plenka_admin
POSTGRES_ADMIN_PASSWORD=replace-me-unique-admin-database-password
DATABASE_OWNER_USER=plenka_owner
DATABASE_OWNER_PASSWORD=replace-me-unique-owner-database-password
DATABASE_APP_USER=plenka_app
DATABASE_APP_PASSWORD=replace-me-unique-runtime-database-password
POSTGRES_DB=plenka_pilot
MIGRATION_DATABASE_URL=replace-me-private-owner-database-url
DATABASE_URL=replace-me-private-runtime-database-url

APP_ENV=pilot
PALLET_LABEL_PROFILE=pallet-100x100-extended-v6
WAREHOUSE_COVERAGE_V2_ENABLED=false
PILOT_SHORT_PASSWORDS_ENABLED=false
PRODUCTION_COST_RECONCILER_ENABLED=true
NODE_ENV=production
AUTH_DEV_XROLE=off
PORT=3000
SESSION_TTL=43200
PASSWORD_SETUP_TTL=1800
LOGIN_RATE_MAX=10
LOGIN_RATE_MAX_KEYS=10000
LOGIN_RATE_WINDOW_MS=60000

DEVICE_GATEWAY_SCALE=on
DEVICE_GATEWAY_PRINTER=on
GATEWAY_SIMULATOR=off
GATEWAY_COMMAND_TIMEOUT_MS=15000

ONEC_LIVE=false
ONEC_WRITE=false
ONEC_TIMEOUT_MS=5000
ONEC_FINANCE_SYNC_ENABLED=false
ONEC_FINANCE_SYNC_INTERVAL_MS=300000
ONEC_PAYMENT_SYNC_ENABLED=false
ONEC_PAYMENT_AUTO_APPLY_ENABLED=false
ONEC_SYNC_ENABLED=false
ONEC_SYNC_INTERVAL_MS=900000
ONEC_SYNC_PAGE_SIZE=250

SEED_PROFILE=pilot
SEED_PILOT_PASSWORD_COMMERCIAL=replace-me-unique-password
SEED_PILOT_PASSWORD_PRODUCTION=replace-me-unique-password
SEED_PILOT_PASSWORD_OPERATOR=replace-me-unique-password
SEED_PILOT_PASSWORD_OPERATOR_2=replace-me-unique-password
SEED_PILOT_PASSWORD_OPERATOR_3=replace-me-unique-password
SEED_PILOT_PASSWORD_WAREHOUSE=replace-me-unique-password
SEED_PILOT_PASSWORD_FINANCE=replace-me-unique-password
SEED_PILOT_PASSWORD_DIRECTOR=replace-me-unique-password
SEED_PILOT_PASSWORD_ADMIN=replace-me-unique-password
SEED_PILOT_AGENT_TOKEN_POST_1=replace-me-canonical-ptk-token
SEED_PILOT_AGENT_TOKEN_POST_2=replace-me-canonical-ptk-token
SEED_PILOT_AGENT_TOKEN_POST_3=replace-me-canonical-ptk-token
SEED_PILOT_AGENT_TOKEN_POST_4=replace-me-canonical-ptk-token
SEED_PILOT_AGENT_TOKEN_POST_5=replace-me-canonical-ptk-token

BACKUP_DIR=/opt/plenka/backups
BACKUP_RETENTION_COUNT=14
BACKUP_RETENTION_DAYS=30
