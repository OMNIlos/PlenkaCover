# Physical Ubuntu post. Copy to /etc/plenka-gateway/agent.env as root:plenka-gateway 0640.
# Never commit the real post token, device identity, serial path, printer address or raw frames.
GATEWAY_DEPLOYMENT_MODE=physical
GATEWAY_API_URL=https://replace-with-vps-host/api
GATEWAY_AGENT_TOKEN=replace-with-one-post-token
GATEWAY_POST_CODE=POST-1
GATEWAY_SCALE_DEVICE_ID=replace-with-bound-scale-id
GATEWAY_PRINTER_DEVICE_ID=replace-with-bound-printer-id
GATEWAY_SCANNER_DEVICE_ID=replace-with-bound-scanner-id
SCANNER_HID_PATH=/dev/input/by-id/usb-replace-with-scanner-event-kbd

GATEWAY_POLL_INTERVAL_MS=1000
GATEWAY_HEARTBEAT_INTERVAL_MS=5000
GATEWAY_BUFFER_DIR=/var/lib/plenka-gateway

SCALE_MODE=massa-k-protocol-100
SCALE_SERIAL_PORT=/dev/serial/by-id/replace-with-scale
# Verified pilot RS-232 -> USB profile. Native USB virtual COM alternative: 57600/none.
SCALE_SERIAL_BAUD=4800
SCALE_SERIAL_PARITY=even
SCALE_READ_TIMEOUT_MS=1500
SCALE_ASSUME_STABLE=off
SCALE_SIMULATED_OFFLINE=off

PRINTER_MODE=cups-zpl
PRINTER_CUPS_QUEUE=replace-with-cups-queue
# Required in physical cups-zpl mode and must name a separate warehouse printer queue.
PRINTER_WAREHOUSE_CUPS_QUEUE=replace-with-warehouse-cups-queue
# Ethernet alternative only: set PRINTER_MODE=tcp9100 and fill both values.
PRINTER_TCP_HOST=
PRINTER_TCP_PORT=9100
PRINTER_DPI=203
PRINTER_MAX_WIDTH_DOTS=864
PRINTER_SIMULATED_FAIL=off
