{
  "name": "@plenka/api",
  "version": "0.0.1",
  "private": true,
  "description": "Плёнки Контур backend v1 — NestJS API.",
  "scripts": {
    "prebuild": "npm run db:generate",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "APP_ENV=test jest",
    "test:watch": "APP_ENV=test jest --watch",
    "test:e2e": "NODE_ENV=test APP_ENV=development AUTH_DEV_XROLE=on GATEWAY_STALE_AFTER_SEC=3600 GATEWAY_OFFLINE_AFTER_SEC=7200 jest --config ./test/jest-e2e.json",
    "test:e2e:auth-runtime": "NODE_ENV=test APP_ENV=test AUTH_DEV_XROLE=on jest --config ./test/jest-e2e.json auth-runtime --runInBand",
    "coverage:shadow": "ts-node src/scripts/warehouse-coverage-shadow.ts",
    "warehouse:pallet-cutover": "ts-node src/scripts/warehouse-pallet-cutover.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "ts-node prisma/seed.ts",
    "db:reset:pilot-demo": "ts-node src/scripts/pilot-demo-reset.ts",
    "db:purge:pilot-order-history": "ts-node src/scripts/pilot-order-history-purge.ts",
    "db:seed:director-demo": "ts-node scripts/seed-director-analytics-demo.ts",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.5",
    "@pdf-lib/fontkit": "^1.1.1",
    "@plenka/contracts": "*",
    "@prisma/client": "^6.2.1",
    "@resvg/resvg-js": "^2.6.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dejavu-fonts-ttf": "^2.37.3",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.28",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "typescript-eslint": "^8.20.0",
    "jest": "^29.7.0",
    "jsqr": "1.4.0",
    "prisma": "^6.2.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "maxWorkers": 1
  }
}
