# Isolated localhost-only database used by the Director analytics preview seed.
DIRECTOR_PREVIEW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/plenka?schema=local_graph_director

# Safe defaults for the full read-only 1C source synchronization.
ONEC_SYNC_ENABLED=false
ONEC_SYNC_INTERVAL_MS=900000
ONEC_SYNC_PAGE_SIZE=250
