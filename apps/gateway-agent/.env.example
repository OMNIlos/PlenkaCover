# Copy to apps/gateway-agent/.env and adjust. .env is gitignored — never commit real tokens.

# --- Platform connection (outbound only; the agent NEVER accepts inbound connections) ---
# development keeps simulator/bench modes available. physical enforces trusted HTTPS,
# MASSA-K Protocol 100, a physical printer transport, and a stable serial path at startup.
GATEWAY_DEPLOYMENT_MODE=development
GATEWAY_API_URL=http://localhost:3000/api
# Per-post token supplied out-of-band by the VPS owner. Never reuse a dev-seed token.
# Pilot format: ptk_ + canonical unpadded base64url of at least 32 random bytes.
# Generate: node -e "console.log('ptk_'+require('crypto').randomBytes(32).toString('base64url'))"
GATEWAY_AGENT_TOKEN=replace-with-unique-post-token
# Physical mode rejects POST/device/template placeholders: use the exact VPS Post.code and
# DeviceRuntime ids provisioned for this industrial post.
GATEWAY_POST_CODE=POST-1

# --- Device bindings (DeviceRuntime ids from the seed for this post) ---
GATEWAY_SCALE_DEVICE_ID=dev-scale-1
GATEWAY_PRINTER_DEVICE_ID=dev-printer-1
# Scanner is a browser-owned HID keyboard wedge. The agent only checks its stable Linux device
# path for ready/offline heartbeat status; it never reads scanner keystrokes.
GATEWAY_SCANNER_DEVICE_ID=dev-scanner-1
SCANNER_HID_PATH=/dev/input/by-id/usb-replace-with-scanner-event-kbd

# --- Timing ---
GATEWAY_POLL_INTERVAL_MS=1000
GATEWAY_HEARTBEAT_INTERVAL_MS=5000

# --- Scale (MASSA-K TV-M-300.2-A(RUEW)3) ---
# simulated | massa-k-protocol-100 | serial (legacy ASCII test adapter only)
SCALE_MODE=simulated
# Use a stable /dev/serial/by-id symlink. COM3 is only a Windows bench fallback.
SCALE_SERIAL_PORT=/dev/serial/by-id/usb-MASSA-K-example
# Verified pilot RS-232 -> USB profile: terminal protocol 100, 4800 baud, even parity.
# Compatible native USB virtual COM alternative: 57600/none.
SCALE_SERIAL_BAUD=4800
SCALE_SERIAL_PARITY=even
# Legacy ASCII mode only:
SCALE_POLL_COMMAND=
SCALE_READ_TIMEOUT_MS=1500
SCALE_ASSUME_STABLE=off
SCALE_SIMULATED_OFFLINE=off

# --- Printer (MERTECH TLP4, 203 dpi, 100 x 150 mm labels) ---
# simulated | tcp9100 | cups-zpl | windows-command
PRINTER_MODE=simulated
# cups-zpl: Ubuntu CUPS queue backed by the official MERTECH HT600 (203 DPI) driver.
PRINTER_CUPS_QUEUE=TLP4
# Required in physical cups-zpl mode and must differ from PRINTER_CUPS_QUEUE.
# Big-Bag and 100 x 150 mm pallet labels use the dedicated warehouse printer.
# A blank value is permitted only outside physical cups-zpl mode.
PRINTER_WAREHOUSE_CUPS_QUEUE=
# tcp9100: printer's Ethernet RAW port
# Documentation-only address; replace in the post's uncommitted .env.
PRINTER_TCP_HOST=192.0.2.10
PRINTER_TCP_PORT=9100
# Fixed pallet-label profile: one 100 x 150 mm copy, 203 dpi, 100 mm = 800 dots.
PRINTER_DPI=203
PRINTER_MAX_WIDTH_DOTS=864
# windows-command: command run for each label; {file} is replaced with the label-file path.
# Example (binary RAW copy to a shared Windows printer):
#   PRINTER_WINDOWS_COMMAND=cmd /c copy /b "{file}" "\\localhost\TLP4"
# or a PowerShell script: powershell -ExecutionPolicy Bypass -File print-label.ps1 -Path {file}
PRINTER_WINDOWS_COMMAND=
# Demo-only: force the simulated printer to fail (exercises the failed-print block).
PRINTER_SIMULATED_FAIL=off

# --- Durable local state ---
# Ingest events and unacknowledged command results survive outages/restarts. The directory and
# JSONL journals are created with owner-only permissions; protect and back them up as evidence.
GATEWAY_BUFFER_DIR=.gateway-buffer
