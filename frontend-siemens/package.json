{
  "name": "film-production-siemens-prototype",
  "version": "0.1.0",
  "description": "Role-first film production product prototype.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "check:payroll-tariff-orders": "node scripts/payroll-tariff-orders-smoke.mjs",
    "check:css-debt": "node scripts/css-debt-audit.mjs",
    "check:dom": "node scripts/dom-leakage-check.mjs",
    "check:button-contrast": "node scripts/button-contrast-audit.mjs",
    "check:show-ready": "node scripts/show-ready-audit.mjs",
    "check:auth-shell": "node scripts/auth-shell-smoke.mjs",
    "check:dependency-security": "node --test scripts/dependency-security.node-test.mjs && npm audit --audit-level=high",
    "check:harness-contracts": "tsc -p scripts/tsconfig.harnesses.json",
    "check:assignment-polling": "node scripts/production-assignment-polling-smoke.mjs",
    "check:route-normalization": "node scripts/route-normalization-smoke.mjs",
    "check:production-fail-closed": "npm run build && node scripts/production-fail-closed-smoke.mjs",
    "check:phase3-demo-smoke": "node scripts/phase3-demo-smoke.mjs",
    "check:release-contracts": "node --test scripts/business-performance-smoke-fixture.node-test.mjs scripts/business-performance-live-smoke-contract.node-test.mjs scripts/business-performance-live-smoke.node-test.mjs scripts/interface-invariants.node-test.mjs scripts/phase3-demo-artifacts.node-test.mjs scripts/release-smoke-hardening.node-test.mjs scripts/show-ready-audit.node-test.mjs scripts/visual-noise-audit.node-test.mjs",
    "check:visual-noise": "node scripts/visual-noise-audit.mjs",
    "check:production-1024": "node scripts/production-hub-1024-audit.mjs",
    "check:role-display-contract": "node scripts/role-display-contract-smoke.mjs",
    "check:raw-material-module": "node scripts/raw-material-module-smoke.mjs",
    "check:warehouse-responsive": "node scripts/warehouse-inventory-responsive-smoke.mjs",
    "check:interface-invariants": "npm run check:release-contracts && node scripts/interface-invariants.mjs && npm run check:production-1024",
    "check:operator-table-first": "node scripts/operator-table-first-viewport-check.mjs",
    "check:production-shell-layout": "node scripts/production-shell-layout-check.mjs",
    "check:production-problems": "node scripts/production-problems-smoke.mjs",
    "check:warehouse-hid": "node scripts/warehouse-hid-behavior-check.mjs",
    "check:modal-focus": "node scripts/plenki-modal-focus-check.mjs",
    "check:queue-archive-date": "node scripts/queue-archive-date-smoke.mjs",
    "check:final-human-ux": "node scripts/final-human-ux-smoke.mjs",
    "check:admin-day4": "node scripts/admin-day4-smoke.mjs",
    "check:admin-live": "node scripts/admin-control-plane-live-smoke.mjs",
    "check:pallet-label-layout": "node scripts/pallet-label-layout-editor-smoke.mjs",
    "check:commercial-live": "node scripts/commercial-live-smoke.mjs",
    "check:commercial-pipeline": "node scripts/commercial-pipeline-viewport-check.mjs",
    "check:commercial-action-layout": "node scripts/commercial-action-controls-layout-check.mjs",
    "check:commercial-counterparty-picker": "node scripts/commercial-counterparty-picker-dom-check.mjs",
    "check:director-analytics": "npm run build && node scripts/director-control-browser-smoke.mjs",
    "check:director-penalties-layout": "node scripts/director-penalties-layout-check.mjs",
    "check:director-analytics:e2e": "npm run build && node scripts/cross-contour-live-smoke.mjs",
    "check:director-analytics:max-label": "npm run build && node scripts/director-control-browser-smoke.mjs",
    "check:commercial-recipe-catalog-live": "node scripts/commercial-recipe-catalog-live-smoke.mjs",
    "check:recipe-editor": "node scripts/recipe-editor-check.mjs",
    "check:bundle-freshness": "node scripts/frontend-bundle-freshness-check.mjs",
    "check:cross-contour-live": "node scripts/cross-contour-live-smoke.mjs",
    "check:notification-reliability": "node scripts/cross-contour-live-smoke.mjs",
    "check:warehouse-coverage-v2": "node --test scripts/warehouse-coverage-v2-release-gate.node-test.mjs && node scripts/warehouse-coverage-v2-release-gate.mjs",
    "check:day5": "node scripts/cross-role-day5-smoke.mjs",
    "check:recoveries": "node scripts/recovery-action-audit.mjs",
    "check:nightly": "node --test scripts/nightly-show-ready-audit.node-test.mjs && node scripts/nightly-show-ready-audit.mjs && npm run check:director-analytics:max-label"
  },
  "dependencies": {
    "@siemens/ix": "5.0.0",
    "@siemens/ix-icons": "3.4.0",
    "@siemens/ix-react": "5.0.0",
    "@vitejs/plugin-react": "6.0.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "vite": "8.0.16"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "nanoid": "3.3.18",
    "postcss": "8.5.25"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/react": "18.3.29",
    "@types/react-dom": "18.3.7",
    "@types/react-test-renderer": "18.3.1",
    "playwright": "1.57.0",
    "react-test-renderer": "18.3.1",
    "vitest": "^4.1.10"
  }
}
