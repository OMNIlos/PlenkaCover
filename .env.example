
# Copy to .env and adjust. .env is gitignored.

# Postgres (matches docker-compose.yml host port 5433 → container 5432)
DATABASE_URL="postgresql://plenka:plenka@localhost:5433/plenka?schema=public"

# API
PORT=3000
# Required. Exactly one of: development, test, pilot, production.
APP_ENV=development
# Automatic warehouse coverage V2 stays off until a separate activation.
WAREHOUSE_COVERAGE_V2_ENABLED=false
# Node runtime optimization only; authorization never derives from NODE_ENV.
NODE_ENV=development
# Browser-facing origin. Pilot/production require one exact HTTPS, non-local origin.
PUBLIC_ORIGIN=http://localhost:5173
# Same-origin is the default: leave CORS_ORIGINS unset. For an intentional cross-origin
# development client, set an exact comma-separated allowlist (wildcards and paths are rejected).
# CORS_ORIGINS=http://localhost:5173

# Auth (V2 S1)
# Dev-only x-role mock: active ONLY for the exact pair APP_ENV=development + this flag "on".
# Test, pilot and production always require real Bearer sessions.
AUTH_DEV_XROLE=on
# Session lifetime in seconds (default 43200 = 12h).
SESSION_TTL=43200
# Short-lived session used only to replace a temporary password (seconds).
PASSWORD_SETUP_TTL=1800
# Per-client login throttle (validated bounded integers).
LOGIN_RATE_MAX=10
LOGIN_RATE_MAX_KEYS=10000
LOGIN_RATE_WINDOW_MS=60000
# Seed mode is mandatory. Demo is development/test-only; pilot requires APP_ENV=pilot and every
# per-account/per-post secret below. Never reuse one password or token across entries.
SEED_PROFILE=demo
# Demo-only shared password used by the local seed graph.
SEED_PASSWORD=plenka-dev
# Pilot secret key names (provide externally; intentionally no values/defaults here).
# Enable four-digit per-account pilot PINs only by setting the next key to exact "true" externally.
# PILOT_SHORT_PASSWORDS_ENABLED
# Agent tokens use `ptk_` + canonical unpadded base64url for at least 32 random bytes:
# SEED_PILOT_PASSWORD_COMMERCIAL
# SEED_PILOT_PASSWORD_PRODUCTION
# SEED_PILOT_PASSWORD_OPERATOR
# SEED_PILOT_PASSWORD_OPERATOR_2
# SEED_PILOT_PASSWORD_OPERATOR_3
# SEED_PILOT_PASSWORD_WAREHOUSE
# SEED_PILOT_PASSWORD_FINANCE
# SEED_PILOT_PASSWORD_DIRECTOR
# SEED_PILOT_PASSWORD_ADMIN
# SEED_PILOT_AGENT_TOKEN_POST_1
# SEED_PILOT_AGENT_TOKEN_POST_2
# SEED_PILOT_AGENT_TOKEN_POST_3
# SEED_PILOT_AGENT_TOKEN_POST_4
# SEED_PILOT_AGENT_TOKEN_POST_5

# Gateway (V2 S4) — device access via on-post agents (Variant B).
# Route scale/printer through the post gateway instead of local mocks.
DEVICE_GATEWAY_SCALE=off
# REQUIRED for the warehouse direct-print button. While this is off the API exposes every
# printer as unavailable and rejects print requests instead of reporting mock success.
DEVICE_GATEWAY_PRINTER=off
# Attach the in-process SimulatedGatewayAgent to every post at boot (dev/demo, no hardware).
# For the REAL on-post agent (apps/gateway-agent, e.g. a Windows laptop playing POST-1):
# set GATEWAY_SIMULATOR=off, keep DEVICE_GATEWAY_*=on, and run the agent — same contract,
# no business-logic changes (see docs/device-gateway-production-demo.md).
GATEWAY_SIMULATOR=off
# Command response timeout (ms) before a device read is treated as offline → 503.
# With a real polling agent keep this comfortably above GATEWAY_POLL_INTERVAL_MS (agent side).
GATEWAY_COMMAND_TIMEOUT_MS=5000
# Server-derived liveness thresholds. A missing heartbeat becomes stale first, then offline.
GATEWAY_STALE_AFTER_SEC=90
GATEWAY_OFFLINE_AFTER_SEC=300
# Per-post agent tokens for the simulated agent (seed uses AGENT_TOKEN_<POST-CODE>, e.g. POST-1 → agent-post-1).

# 1C stays mock/off by default. Credentials are required only if ONEC_LIVE=true;
# pilot/production additionally require an HTTPS ONEC_BASE_URL.
ONEC_LIVE=false
ONEC_WRITE=false
ONEC_WRITE_CONFIRM=off
ONEC_TIMEOUT_MS=5000
# Full source synchronization is manual by default. Enable its timer only after a successful
# preview, initial apply, reconciliation, and physical-stock checksum verification.
ONEC_SYNC_ENABLED=false
ONEC_SYNC_INTERVAL_MS=900000
ONEC_SYNC_PAGE_SIZE=250
# Finance-specific polling is independent from the full 1С catalog sync and is off by default.
ONEC_FINANCE_SYNC_ENABLED=false
ONEC_FINANCE_SYNC_INTERVAL_MS=300000
ONEC_PAYMENT_SYNC_ENABLED=false
# Enable only after exact-reference reconciliation has been validated on the concrete 1С base.
ONEC_PAYMENT_AUTO_APPLY_ENABLED=false
# ONEC_BASE_URL=https://onec.example.com/odata
# ONEC_USERNAME=service-account
# ONEC_PASSWORD=set-via-secret-manager
# Exact published OData field containing PLENKA_ORDER=<orderNumber>.
# Required for live invoice auto-linking; intentionally has no default.
# ONEC_INVOICE_ORDER_REFERENCE_FIELD=КомментарийПлатформы
# Target references for the one explicitly gated stock-posting operation.
# ONEC_ORG_KEY=00000000-0000-0000-0000-000000000000
# ONEC_WAREHOUSE_KEY=00000000-0000-0000-0000-000000000000
# ONEC_GOODS_ACCOUNT_KEY=00000000-0000-0000-0000-000000000000
# ONEC_STOCK_NOMENCLATURE=PLENKA-RAW-STOCK
